---
import { site, ubicacion, mapaUrl, rutaUrl } from '../config';
import MapaPreview from './MapaPreview.astro';
---
<section id="location" class="section">
  <div class="location-grid">
    <div class="location-content reveal">
      <div class="kicker">Ubicación</div>
      <h2 class="h2">En el corazón de la Sierra.</h2>
      <p>A solo 80 minutos de Saltillo y 2 horas de Monterrey. Un entorno único para desconectar de la ciudad y respirar aire puro.</p>

      <div class="location-details">
        <div class="loc-item">
          <i class="ph ph-map-pin" aria-hidden="true"></i>
          <div>
            <strong>{ubicacion.referencia}</strong>
            <span>México</span>
          </div>
        </div>
        <div class="loc-item">
          <i class="ph ph-car" aria-hidden="true"></i>
          <div>
            <strong>Acceso en auto</strong>
            <span>{ubicacion.acceso}</span>
          </div>
        </div>
      </div>

      <div class="location-actions">
        <a href={rutaUrl} target="_blank" rel="noopener" class="btn btn--primary">Cómo llegar <i class="ph ph-navigation-arrow" aria-hidden="true"></i></a>
        <a href={mapaUrl} target="_blank" rel="noopener" class="btn btn--outline">Abrir en Google Maps <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </div>

    <div class="location-map reveal">
      <MapaPreview alto="420px" />
    </div>
  </div>
</section>

<style>
  .location-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .location-content { display: grid; gap: 20px; align-content: start; }
  .location-content p { margin: 0; font-size: 16px; line-height: 1.6; color: rgba(var(--ink-rgb), .72); max-width: 460px; }
  .location-details { display: flex; flex-direction: column; gap: 1.25rem; margin-top: .5rem; }
  .loc-item { display: flex; gap: 1rem; align-items: flex-start; }
  .loc-item i { font-size: 1.5rem; color: var(--soft); margin-top: .2rem; }
  .loc-item strong { display: block; font-size: 1.05rem; font-weight: 500; margin-bottom: .2rem; }
  .loc-item span { color: rgba(var(--ink-rgb), .62); font-size: .95rem; }
  .location-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: .5rem; }
  .location-actions .btn--primary { padding: 14px 24px; }
  .location-actions .btn--outline { padding: 13px 20px; }
  @media (max-width: 850px) { .location-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
