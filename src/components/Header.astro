---
import { site } from '../config';
import { url } from '../lib/url';

const home = url();

const waUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('¡Hola! Quiero consultar por disponibilidad en Cabañas Matilde.')}`;
---
<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a href={`${home}#top`} class="brand" aria-label={`${site.name}, volver arriba`}>
      <img class="brand__logo" src={url('images/logo.png')} alt={site.name} width="86" height="44">
      <span class="brand__place">{site.place.toUpperCase()}</span>
    </a>

    <!-- Enlaces de navegación (Solo Escritorio) -->
    <div class="nav__links" id="navLinks">
      <a href={`${home}#rooms`}>Cabañas</a>
      <a href={`${home}#location`}>Ubicación</a>
      <a href={`${home}#direct`}>Reserva directa</a>
      <a href={`${home}#stories`}>Huéspedes</a>
    </div>

    <button class="theme-toggle" type="button" id="themeToggle" aria-label="Cambiar modo claro/oscuro">
      <i class="ph ph-sun" aria-hidden="true"></i><i class="ph ph-moon" aria-hidden="true"></i>
    </button>

    <!-- Botón de WhatsApp para Escritorio -->
    <a href={waUrl} class="nav__cta btn-wa nav__cta--desktop" target="_blank" aria-label="Contactar por WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </nav>
</header>

<!-- BOTÓN FLOTANTE DE WHATSAPP PARA MÓVILES (A LA DERECHA) -->
<a href={waUrl} class="floating-wa" target="_blank" aria-label="Contactar por WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
  .brand__logo { height: 44px; width: auto; display: block; }
  @media (max-width: 560px) { .brand__logo { height: 38px; } }

  /* =========================================================
     ESTILOS DEL BOTÓN VERDE ESCRITORIO
     ========================================================= */
  .btn-wa {
    background: #25D366 !important;
    background-image: none !important;
    color: #ffffff !important;
    border: none !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 0.5rem 1.2rem !important;
    border-radius: 50px !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    font-size: 0.95rem !important;
    transition: background-color 0.2s ease !important;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.2) !important;
  }

  .btn-wa:hover, 
  .btn-wa:focus {
    background: #1ebe5d !important;
    color: #ffffff !important;
  }

  /* =========================================================
     LÓGICA RESPONSIVE (MÓVILES)
     ========================================================= */
  
  /* Ocultamos el botón flotante en PC por defecto */
  .floating-wa {
    display: none;
  }

  @media (max-width: 850px) {
    /* 1. Ocultamos los enlaces del menú */
    .nav__links { 
      display: none !important; 
    }

    /* 2. Ocultamos el botón de WhatsApp de la barra superior */
    .nav__cta--desktop { 
      display: none !important; 
    }

    /* 3. Mostramos el botón flotante en móviles (A LA DERECHA) */
    .floating-wa {
      display: flex !important;
      position: fixed !important;
      bottom: 20px !important;
      right: 20px !important; /* <-- ACÁ ESTÁ EL CAMBIO */
      z-index: 9999 !important;
      width: 55px !important;
      height: 55px !important;
      background-color: #25D366 !important;
      color: #ffffff !important;
      border-radius: 50% !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3) !important;
      transition: transform 0.2s ease !important;
    }

    .floating-wa svg {
      width: 30px !important;
      height: 30px !important;
    }

    .floating-wa:hover,
    .floating-wa:active {
      transform: scale(1.1) !important;
      background-color: #1ebe5d !important;
    }
  }
</style>