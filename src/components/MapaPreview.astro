---
/* Vista previa de Google Maps: al tocarla abre Google Maps (y desde ahí la ruta).
   Si el mapa no carga, se ve igual un fondo con el pin y el botón. */
import { site, mapaUrl, mapaEmbedUrl } from '../config';
interface Props { alto?: string }
const { alto = '400px' } = Astro.props;
---
<div class="mapa" style={`--alto:${alto}`}>
  <div class="mapa__fallback" aria-hidden="true"><i class="ph ph-map-pin"></i></div>
  <iframe src={mapaEmbedUrl} title={`Mapa de ${site.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" tabindex="-1"></iframe>
  <a class="mapa__tap" href={mapaUrl} target="_blank" rel="noopener" aria-label="Abrir la ubicación en Google Maps">
    <span><i class="ph ph-map-pin" aria-hidden="true"></i> Abrir en Google Maps</span>
  </a>
</div>

<style>
  .mapa {
    position: relative; height: var(--alto); border-radius: 22px; overflow: hidden;
    border: 1px solid rgba(var(--ink-rgb), .14);
    box-shadow: var(--navshadow);
    background: var(--card);
  }
  .mapa__fallback { position: absolute; inset: 0; display: grid; place-items: center; font-size: 56px; color: var(--kicker); opacity: .6; }
  .mapa iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; pointer-events: none; }
  .mapa__tap {
    position: absolute; inset: 0; z-index: 2; display: flex; align-items: flex-end; justify-content: center;
    padding: 18px; color: #fff8f8;
  }
  .mapa__tap span {
    display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 999px; font-size: 13px;
    background: rgba(20, 12, 14, .72); border: 1px solid rgba(255, 248, 248, .25);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: background .2s, transform .2s;
  }
  .mapa__tap:hover span { background: var(--orange); transform: translateY(-2px); }
  .mapa__tap:hover { color: #fff8f8; }
</style>
