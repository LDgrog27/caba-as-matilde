---
/* Galería de cabañas: mantiene la grilla de 5 imágenes (una alta a la izquierda,
   dos a la derecha y dos abajo), pero ahora cada imagen es una cabaña real que
   lleva a su propia página. Se alimenta de src/content/cabanas/. */
import { cabanasActivas, imagenesDe, mxnCorto } from '../lib/cabanas';
import { incluyeTodas } from '../data/propiedad';
import { url } from '../lib/url';

const cabanas = (await cabanasActivas()).slice(0, 5);
const letras = ['a', 'b', 'c', 'd', 'e'];
const sizes = [
  '(max-width: 760px) 100vw, 60vw',
  '(max-width: 760px) 100vw, 42vw',
  '(max-width: 760px) 100vw, 42vw',
  '(max-width: 760px) 100vw, 50vw',
  '(max-width: 760px) 100vw, 50vw',
];
---
<section id="rooms" class="section">
  <div class="rooms-head reveal">
    <div>
      <div class="kicker">Nuestras Cabañas</div>
      <h2 class="h2">Naturaleza y confort en la sierra.</h2>
    </div>
    <p>Espacios rústicos pero equipados, pensados para que disfrutes del aire libre sin perder las comodidades básicas. Entra a cada cabaña para ver todas sus fotos y detalles.</p>
  </div>

  <div class="gallery-custom">
    {cabanas.map((c, i) => {
      const foto = imagenesDe(c)[0];
      return (
        <figure class={`tile tile--${letras[i]} force-dark reveal`}>
          <img src={foto.src} alt={foto.alt} width="1600" height="1068" sizes={sizes[i]} loading="lazy">
          <a class="tile__link" href={url(`cabanas/${c.id}/`)} aria-label={`Ver ${c.data.nombre}`}></a>
          <figcaption>
            <span class="label">Hasta {c.data.capacidadMax} personas</span>
            <strong>{c.data.nombre}</strong>
            <span class="tile__meta">1 noche {mxnCorto(c.data.precio1Noche)} · 2 noches {mxnCorto(c.data.precio2Noches)}</span>
            <span class="tile__go">Ver cabaña <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
          </figcaption>
        </figure>
      );
    })}
  </div>

  <div class="amenities">
    {incluyeTodas.map((a) => (
      <div class="amenity reveal">
        <div class="icon-tile"><i class={`ph ph-${a.icono}`} aria-hidden="true"></i></div>
        <h3>{a.titulo}</h3>
        <p>{a.texto}</p>
      </div>
    ))}
  </div>
</section>

<style>
  /* Grilla personalizada para 5 imágenes */
  .gallery-custom {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  /* Ajustes de las imágenes */
  .gallery-custom .tile {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    margin: 0;
  }
  
  .gallery-custom .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-custom .tile:hover img {
    transform: scale(1.02);
  }

  /* Posicionamiento en la grilla */
  .tile--a { 
    grid-column: 1; 
    grid-row: 1 / 3; 
    min-height: 550px; /* Aumentamos la altura de la imagen alargada (aprox 3-5cm más) */
  }
  .tile--b { 
    grid-column: 2; 
    grid-row: 1; 
    min-height: 260px; 
  }
  .tile--c { 
    grid-column: 2; 
    grid-row: 2; 
    min-height: 260px; 
  }
  .tile--d { 
    grid-column: 1; 
    grid-row: 3; 
    min-height: 280px; 
  }
  .tile--e { 
    grid-column: 2; 
    grid-row: 3; 
    min-height: 280px; 
  }

  /* Ajustes responsive para celulares */
  @media (max-width: 760px) {
    .gallery-custom {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .tile--a, .tile--b, .tile--c, .tile--d, .tile--e {
      grid-column: 1;
      grid-row: auto;
      min-height: 250px;
    }
    .tile--a { min-height: 350px; }
  }

  /* Cada imagen es un enlace a la página de la cabaña */
  .tile__link { position: absolute; inset: 0; z-index: 2; }
  .tile figcaption { z-index: 1; }
  .tile__meta { font-size: 12px; color: rgba(var(--ink-rgb), .78); font-weight: 400; }
  .tile__go { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--kicker2); transition: gap .2s; }
  .tile:hover .tile__go { gap: 10px; }
</style>