---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import GaleriaCabana from '../../components/GaleriaCabana.astro';
import Stories from '../../components/Stories.astro';
import MapaPreview from '../../components/MapaPreview.astro';
import Footer from '../../components/Footer.astro';
import { cabanasActivas, imagenesDe, precioExtraDe, mxnCorto } from '../../lib/cabanas';
import { incluyeTodas, horarios, adelantoPct, queLlevarComun, noIncluyeComun, reglamentoComun } from '../../data/propiedad';
import { site, ubicacion, rutaUrl, mapaUrl } from '../../config';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const cabanas = await cabanasActivas();
  return cabanas.map((cabana) => ({ params: { slug: cabana.id }, props: { cabana } }));
}

const { cabana } = Astro.props;
const d = cabana.data;
const todas = await cabanasActivas();
const otras = todas.filter((c) => c.id !== cabana.id);
const imagenes = imagenesDe(cabana);
const { Content } = await render(cabana);

// ¿El archivo .md trae speech de venta? (si solo tiene comentarios, se usa un texto genérico)
const tieneSpeech = (cabana.body ?? '').replace(/<!--[\s\S]*?-->/g, '').trim().length > 0;
const titular = d.titular ?? `Una cabaña para hasta ${d.capacidadMax} personas, en plena sierra.`;

const extra = precioExtraDe(cabana);
const cotizarUrl = `${url()}?cabana=${cabana.id}#book`;
const waUrl = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`¡Hola! Me interesa ${d.nombre} en Cabañas Matilde. ¿Qué fechas tienen disponibles?`)}`;
const listas = [
  { titulo: 'Qué llevar', icono: 'backpack', items: d.queLlevar.length ? d.queLlevar : queLlevarComun },
  { titulo: 'Qué no incluye', icono: 'prohibit', items: d.noIncluye.length ? d.noIncluye : noIncluyeComun },
  { titulo: 'Reglamento', icono: 'scroll', items: d.reglamento.length ? d.reglamento : reglamentoComun },
].filter((l) => l.items.length);
---
<Base
  title={`${d.nombre} · ${site.name}, Sierra de Arteaga`}
  description={`${d.nombre}: hasta ${d.capacidadMax} personas. 1 noche ${mxnCorto(d.precio1Noche)}, 2 noches ${mxnCorto(d.precio2Noches)}. Reserva directo por WhatsApp.`}
>
<div class="page">
  <Header />
  <main>
    <!-- ============ 1. Carrusel automático ============ -->
    <section id="top" class="hero-wrap">
      <GaleriaCabana imagenes={imagenes} etiqueta={`Fotos de ${d.nombre}`}>
        <div class="hero__content">
          <div class="kicker">Cabañas Matilde · Hasta {d.capacidadMax} personas</div>
          <h1>{d.nombre}</h1>
          {d.resumen && <p class="hero__sub">{d.resumen}</p>}
          <div class="hero__ctas">
            <a href={cotizarUrl} class="btn btn--primary">Cotizar mis fechas <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            <a href={waUrl} class="btn btn--glass" target="_blank" rel="noopener">Preguntar por WhatsApp <i class="ph ph-whatsapp-logo" aria-hidden="true"></i></a>
          </div>
        </div>
      </GaleriaCabana>
      {imagenes[0].provisional && <p class="provisional">Fotos de ejemplo: pronto subiremos las fotos reales de {d.nombre}.</p>}
    </section>

    <!-- ============ 2. Speech de venta ============ -->
    <section class="section pitch">
      <div class="pitch__text reveal">
        <div class="kicker">La experiencia</div>
        <h2 class="h2">{titular}</h2>
        <div class="prose">
          {tieneSpeech ? <Content /> : (
            <>
              <p>{d.nombre} tiene capacidad para hasta <strong>{d.capacidadMax} personas</strong>: ideal para reunir a la familia o al grupo de amigos y desconectarse juntos en la Sierra de Arteaga.</p>
              <p>Como todas nuestras cabañas, cuenta con <strong>cocina equipada</strong> y con <strong>asador y fogatero</strong> para disfrutar las noches al aire libre. {d.admiteMascotas ? 'Tus mascotas también son bienvenidas.' : ''}</p>
            </>
          )}
        </div>
        <div class="pitch__cta">
          <a href={cotizarUrl} class="btn btn--primary">Cotizar mis fechas <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>

      <aside class="pitch__side reveal">
        <div class="card">
          <div class="card__head label"><span>Lo que contiene</span><i class="ph ph-house-line" aria-hidden="true"></i></div>
          <ul class="checks">
            {d.amenidades.length
              ? d.amenidades.map((a) => <li><i class="ph-bold ph-check" aria-hidden="true"></i><span>{a}</span></li>)
              : incluyeTodas.slice(0, 3).map((a) => <li><i class="ph-bold ph-check" aria-hidden="true"></i><span><strong>{a.titulo}.</strong> {a.texto}</span></li>)}
          </ul>
        </div>
      </aside>
    </section>

    <!-- ============ 3. Información ============ -->
    <section class="section info">
      <div class="section-head reveal">
        <div class="kicker">Información</div>
        <h2 class="h2">Todo lo que necesitas saber.</h2>
      </div>

      <div class="info__cards">
        <div class="card reveal">
          <div class="card__head label"><span>Tarifas</span><i class="ph ph-hand-coins" aria-hidden="true"></i></div>
          <dl class="rows" style="margin:0">
            <div><dt>1 noche</dt><dd>{mxnCorto(d.precio1Noche)} MXN</dd></div>
            <div><dt>2 noches</dt><dd>{mxnCorto(d.precio2Noches)} MXN</dd></div>
            <div><dt>Cada noche extra</dt><dd>{mxnCorto(extra)} MXN</dd></div>
            <div><dt>Adelanto para reservar</dt><dd>{adelantoPct} %</dd></div>
          </dl>
        </div>
        <div class="card reveal">
          <div class="card__head label"><span>Tu estancia</span><i class="ph ph-key" aria-hidden="true"></i></div>
          <dl class="rows" style="margin:0">
            <div><dt>Llegada</dt><dd>Desde las {horarios.llegada}</dd></div>
            <div><dt>Salida</dt><dd>Hasta la {horarios.salida}</dd></div>
            <div><dt>Capacidad</dt><dd>Hasta {d.capacidadMax} personas</dd></div>
            <div><dt>Mascotas</dt><dd>{d.admiteMascotas ? 'Sí, bienvenidas' : 'No se admiten'}</dd></div>
          </dl>
        </div>
        <div class="card reveal">
          <div class="card__head label"><span>Reserva directa</span><i class="ph ph-whatsapp-logo" aria-hidden="true"></i></div>
          <p class="card__text">Elige tus fechas, mira el total al instante y te abrimos WhatsApp con la cotización lista. Sin comisiones ni intermediarios.</p>
          <a href={cotizarUrl} class="btn btn--outline">Cotizar mis fechas <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>

      {listas.length > 0 && (
        <div class="info__lists">
          {listas.map((l) => (
            <div class="list-card reveal">
              <h3><i class={`ph ph-${l.icono}`} aria-hidden="true"></i> {l.titulo}</h3>
              <ul>{l.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      )}
    </section>

    <Stories cabana={cabana.id} />

    <!-- ============ 4. Ubicación ============ -->
    <section class="section">
      <div class="where">
        <div class="where__text reveal">
          <div class="kicker">Ubicación</div>
          <h2 class="h2">Cómo llegar.</h2>
          <p>{ubicacion.referencia}. A 80 minutos de Saltillo y 2 horas de Monterrey. {ubicacion.acceso}</p>
          <div class="where__btns">
            <a href={rutaUrl} class="btn btn--primary" target="_blank" rel="noopener">Cómo llegar <i class="ph ph-navigation-arrow" aria-hidden="true"></i></a>
            <a href={mapaUrl} class="btn btn--outline" target="_blank" rel="noopener">Abrir en Google Maps <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </div>
        <div class="reveal"><MapaPreview alto="340px" /></div>
      </div>
    </section>

    <!-- ============ 5. Otras cabañas ============ -->
    {otras.length > 0 && (
      <section class="section">
        <div class="section-head reveal">
          <div class="kicker">Otras cabañas</div>
          <h2 class="h2">Mira las demás.</h2>
        </div>
        <div class="others">
          {otras.map((c) => {
            const foto = imagenesDe(c)[0];
            return (
              <figure class="tile force-dark reveal">
                <img src={foto.src} alt={foto.alt} width="1600" height="1068" loading="lazy">
                <a class="tile__link" href={url(`cabanas/${c.id}/`)} aria-label={`Ver ${c.data.nombre}`}></a>
                <figcaption>
                  <span class="label">Hasta {c.data.capacidadMax} personas</span>
                  <strong>{c.data.nombre}</strong>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </section>
    )}
  </main>
  <Footer />
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
</Base>

<style>
  .provisional { margin: 12px 4px 0; font-size: 12px; color: rgba(var(--ink-rgb), .55); }

  /* Speech de venta */
  .pitch { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .pitch__text { display: grid; gap: 22px; }
  .prose { display: grid; gap: 16px; max-width: 60ch; font-size: 18px; line-height: 1.7; color: rgba(var(--ink-rgb), .82); text-wrap: pretty; }
  .prose :global(p) { margin: 0; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(h2), .prose :global(h3) { margin: 8px 0 0; font-family: var(--serif); font-weight: 500; color: var(--ink); }
  .prose :global(ul) { margin: 0; padding-left: 1.2em; }
  .pitch__cta { margin-top: 6px; }
  .pitch__side { position: sticky; top: 110px; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: 14px; line-height: 1.5; color: rgba(var(--ink-rgb), .82); }
  .checks li { display: flex; gap: 12px; align-items: flex-start; }
  .checks i { flex-shrink: 0; margin-top: 3px; color: var(--orange); font-size: 14px; }
  @media (max-width: 900px) { .pitch { grid-template-columns: 1fr; } .pitch__side { position: static; } }

  /* Información */
  .info__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; }
  .card__text { margin: 0; font-size: 14px; line-height: 1.6; color: rgba(var(--ink-rgb), .68); }
  .info__cards .btn--outline { justify-self: start; }
  .info__lists { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 16px; margin-top: 16px; }
  .list-card {
    padding: 26px; border-radius: 22px;
    background: var(--card); border: 1px solid rgba(var(--ink-rgb), .10);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  }
  .list-card h3 { margin: 0 0 14px; display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 500; }
  .list-card h3 i { color: var(--soft); font-size: 20px; }
  .list-card ul { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; font-size: 14px; line-height: 1.55; color: rgba(var(--ink-rgb), .72); }
  .list-card li::marker { color: var(--orange); }

  /* Ubicación */
  .where { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .where__text { display: grid; gap: 18px; }
  .where__text p { margin: 0; font-size: 16px; line-height: 1.6; color: rgba(var(--ink-rgb), .72); max-width: 44ch; }
  .where__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .where__btns .btn--primary { padding: 14px 24px; }
  .where__btns .btn--outline { padding: 13px 20px; }
  @media (max-width: 850px) { .where { grid-template-columns: 1fr; } }

  /* Otras cabañas */
  .others { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); grid-auto-rows: 240px; gap: 16px; }
  .tile__link { position: absolute; inset: 0; z-index: 2; }
  .tile figcaption { z-index: 1; }
</style>
